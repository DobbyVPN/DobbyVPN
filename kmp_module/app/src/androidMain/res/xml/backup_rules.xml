<?xml version="1.0" encoding="utf-8"?>
<!--
  DobbyVPN stores connection material and diagnostic state locally.  Backups
  must never transfer that state off-device.  `allowBackup=false` is the
  platform-level switch; these exclusions make the same decision explicit for
  Android's legacy full-backup parser.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
