require "base64"
require "tmpdir"
require_relative "ios_release_notes"

platform :ios do
  BUNDLE_ID = "vpn.dobby.app"

  desc "Prepare signing"
  lane :prepare_signing do
    keychain_name = "build.keychain-db"
    keychain_password = ENV['KEYCHAIN_PASSWORD']

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600
    )

    Dir.mktmpdir("dobby-signing-") do |tmp|
      cert_path = File.join(tmp, "cert.p12")
      File.binwrite(cert_path, Base64.decode64(ENV.fetch("CERT_P12_BASE64")))
      import_certificate(
        certificate_path: cert_path,
        certificate_password: ENV.fetch("CERT_P12_PASSWORD"),
        keychain_name: keychain_name,
        keychain_password: keychain_password
      )

      keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}")
      unless system("security", "set-key-partition-list", "-S", "apple-tool:,apple:", "-s",
                    "-k", keychain_password, keychain_path)
        UI.user_error!("Failed to configure access to the signing keychain")
      end

      %w[PROVISION_DOBBY_BASE64 PROVISION_DOBBY_TUNNEL_BASE64].each do |variable|
        path = File.join(tmp, "#{variable}.mobileprovision")
        File.binwrite(path, Base64.decode64(ENV.fetch(variable)))
        install_provisioning_profile(path: path)
      end
    end
  end

  desc "Upload the selected Release IPA to TestFlight"
  lane :upload_testflight do
    api_key = app_store_connect_api_key(
      key_id: ENV['APP_STORE_KEY_ID'],
      issuer_id: ENV['APP_STORE_ISSUER_ID'],
      key_content: ENV['APP_STORE_API_KEY'],
      duration: 1200
    )

    # Upload happens in the Apple-only publication job after qualification.
    upload_to_testflight(
      ipa: ENV.fetch("APP_STORE_IPA_PATH"),
      api_key: api_key,
      # A changelog makes Fastlane wait partially and patch beta metadata.
      # Keep the build internal until the explicit App Review submission.
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end

  desc "Submit an existing exact build to production App Review"
  lane :submit_app_store_review do
    version = ENV.fetch("APP_STORE_VERSION")
    selected_build = ENV.fetch("APP_STORE_BUILD_NUMBER")
    notes_file = ENV["APP_STORE_RELEASE_NOTES_FILE"]
    release_notes = if notes_file && !notes_file.empty?
      File.read(notes_file, encoding: "UTF-8")
    else
      ENV["APP_STORE_RELEASE_NOTES"].to_s
    end

    begin
      IosReleaseNotes.validate!(release_notes)
    rescue ArgumentError => error
      UI.user_error!(error.message)
    end

    unless version.match?(/\A\d+\.\d+\.\d+\z/)
      UI.user_error!("APP_STORE_VERSION must use X.Y.Z format")
    end
    unless selected_build.match?(/\A\d+\z/)
      UI.user_error!("APP_STORE_BUILD_NUMBER must be numeric")
    end

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_API_KEY"),
      duration: 1200
    )

    # A publication retry can arrive after App Store Connect accepted the
    # exact version/build but before the child workflow reported success. Read
    # the existing state before calling deliver so that retrying that identity
    # is harmless and a different build on the same version is fail-closed.
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("App Store Connect app #{BUNDLE_ID} was not found") unless app
    platform = Spaceship::ConnectAPI::Platform::IOS
    versions = app.get_app_store_versions(
      filter: { platform: platform },
      includes: "appStoreVersionSubmission,build"
    ).to_a
    matching_versions = versions.select { |candidate| candidate.version_string == version }
    if matching_versions.length > 1
      UI.user_error!("App Store Connect has multiple iOS versions for #{version}")
    end
    existing_version = matching_versions.first
    if existing_version
      attached_build = existing_version.build
      if attached_build && attached_build.version.to_s != selected_build
        UI.user_error!(
          "App Store Connect version #{version} already has build " \
          "#{attached_build.version}, not #{selected_build}"
        )
      end
      submitted_states = %w[
        WAITING_FOR_REVIEW READY_FOR_REVIEW IN_REVIEW
        PENDING_APPLE_RELEASE PENDING_DEVELOPER_RELEASE
        READY_FOR_DISTRIBUTION PROCESSING_FOR_DISTRIBUTION ACCEPTED
        READY_FOR_SALE
      ]
      if submitted_states.include?(existing_version.app_version_state.to_s)
        unless attached_build && attached_build.version.to_s == selected_build
          UI.user_error!("App Store Connect submitted version #{version} has no exact build #{selected_build}")
        end
        UI.success("Exact App Store version #{version} build #{selected_build} is already submitted")
        next
      end
      if %w[DEVELOPER_REJECTED REJECTED METADATA_REJECTED INVALID_BINARY].include?(
        existing_version.app_version_state.to_s
      )
        UI.user_error!(
          "App Store Connect version #{version} is in terminal state " \
          "#{existing_version.app_version_state}"
        )
      end
    end

    options = {
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      platform: "ios",
      app_version: version,
      build_number: selected_build,
      copyright: "#{Time.now.year} Alexander Potemkin",
      support_url: {
        "en-US" => "https://github.com/DobbyVPN/DobbyVPN/issues"
      },
      privacy_url: {
        "en-US" => "https://dobbyvpn.com/privacy"
      },
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      run_precheck_before_submit: true,
      precheck_include_in_app_purchases: false
    }
    options[:release_notes] = { "en-US" => release_notes }

    attempts_remaining = 6
    begin
      upload_to_app_store(**options)
    rescue Spaceship::UnexpectedResponse => error
      build_still_processing =
        error.message.include?("specified pre-release build could not be added")
      attempts_remaining -= 1
      raise unless build_still_processing && attempts_remaining.positive?

      UI.important(
        "Exact build is still processing; retrying production attachment " \
        "(#{attempts_remaining} attempts remain)"
      )
      sleep(240)
      retry
    end
  end
end
