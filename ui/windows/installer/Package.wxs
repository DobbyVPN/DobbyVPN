<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
	<!-- Release UpgradeCode: same as in released 1.5.x MSIs (see desktop_package.py). Debug has its own. -->
	<?ifdef DOBBYVPN_DEBUG?>
		<?define ProductName="DobbyVPN Debug"?>
		<?define UpgradeCode="5C16B3D0-831C-4024-AB10-A76DA27D14FB"?>
	<?else?>
		<?define ProductName="DobbyVPN"?>
		<?define UpgradeCode="AC1AE299-9E08-57FF-A64E-70B0AC9ADB9B"?>
	<?endif?>
	<Package
		Id="DobbyVPN"
		Name="$(var.ProductName)"
		UpgradeCode="$(var.UpgradeCode)"
		Manufacturer="DobbyVPN team"
		Language="1033"
		Version="$(var.DOBBYVPN_VERSION)">

		<CustomAction Id="ReleaseDobbyProtection" FileRef="DobbyBackendFile" ExeCommand="-mode=release-protection"
			Execute="deferred" Impersonate="no" Return="check" />
		<InstallExecuteSequence>
			<Custom Action="ReleaseDobbyProtection" After="StopServices" Condition='REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE' />
		</InstallExecuteSequence>

		<Icon Id="dobbyvpn.ico" SourceFile="dobbyVPN-windows/app/app.ico" />

		<Property Id="ARPPRODUCTICON" Value="dobbyvpn.ico" />
		<Property Id="ARPURLINFOABOUT" Value="https://github.com/DobbyVPN/DobbyVPN" />
		<Property Id="ARPNOMODIFY" Value="yes" />
		<Property Id="DISABLEADVTSHORTCUTS" Value="yes" />
		<Property Id="MSIDISABLERMRESTART" Value="1" />
		<Property Id="MSIRMSHUTDOWN" Value="1" />
		<Property Id="DOBBYVPN_CONTROL_PIPE_SID" Secure="yes" />
		<SetProperty
			Id="DOBBYVPN_CONTROL_PIPE_SID"
			Value="[UserSID]"
			Before="CostFinalize"
			Sequence="both"
			Condition="NOT DOBBYVPN_CONTROL_PIPE_SID" />

		<MediaTemplate EmbedCab="yes" CompressionLevel="high" />

		<!-- Remove the old product before installing components with changed key files: v1.5.0 and the current MSI
		     put dobby_bridge.dll and wintun.dll at the same path in components with different ids, so afterInstallExecute
		     or afterInstallFinalize would delete the new copies. Costing always runs before any of these positions, so a bundled
		     file that is older than the installed one is skipped and then removed with the old product (v1.5.15 over v1.5.11
		     lost 186 runtime files). The bundled .NET runtime is therefore never allowed to go backwards:
		     dotnet-runtime-floor.json and the check in desktop_package.py. -->
		<MajorUpgrade
			AllowDowngrades="no"
			AllowSameVersionUpgrades="yes"
			DowngradeErrorMessage="A newer version of [ProductName] is already installed."
			Schedule="afterInstallInitialize" />

    <Feature Id="Main">
      <ComponentGroupRef Id="AppComponents" />
    </Feature>
  </Package>
</Wix>
