<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Fragment>
    <!-- The backend refuses to serve the control pipe for SYSTEM (core/clientserver/controlplane/windows_user.go), and the pipe owner is
         [UserSID] unless DOBBYVPN_CONTROL_PIPE_SID is passed. An install, repair or upgrade under SYSTEM (Intune, SCCM) without that property
         used to roll back late, in StartServices, with Error 1920; this stops it before anything is installed. A launch condition runs in
         every install sequence, including a major upgrade (the new package is not installed yet), and cannot rely on the SetProperty default
         of Package.wxs, which runs later (before CostFinalize), so it checks the passed property and UserSID itself. Uninstall always passes.
         The property is not remembered between installs: an upgrade under SYSTEM has to pass it again. -->
    <Launch Condition="REMOVE=&quot;ALL&quot; OR (DOBBYVPN_CONTROL_PIPE_SID AND DOBBYVPN_CONTROL_PIPE_SID ~&lt;&gt; &quot;S-1-5-18&quot;) OR (NOT DOBBYVPN_CONTROL_PIPE_SID AND UserSID ~&lt;&gt; &quot;S-1-5-18&quot;)"
            Message="DobbyVPN cannot be installed or upgraded under the SYSTEM account without naming the user who will run it. Run msiexec again with DOBBYVPN_CONTROL_PIPE_SID set to the SID of that user (not S-1-5-18), for example: msiexec /i dobbyVPN-windows-amd64.msi /qn DOBBYVPN_CONTROL_PIPE_SID=S-1-5-21-1111111111-2222222222-3333333333-1001" />
    <!-- The installer asks DobbyVPN.exe to close and waits 10 seconds; if it is still running, the process is terminated with exit code 0
         (the TerminateProcess attribute is the exit code, not a switch). How an instance in another session (RDP, fast user switching)
         is handled was not verified. The window is not restarted after the update (MSIDISABLERMRESTART). -->
    <util:CloseApplication Id="CloseDobbyFrontend" Target="DobbyVPN.exe" CloseMessage="yes" Timeout="10" ElevatedCloseMessage="yes" RebootPrompt="no" TerminateProcess="0" />
    <ComponentGroup Id="AppComponents" Directory="INSTALLFOLDER">
		<!-- The v1.5.1 executable path changed; this needs a new MSI component identity. -->
		<Component Directory="DobbyVPNFolderBin" Id="DobbyVPNExecutable" Guid="da24efb2-1702-4156-8ea1-892b0de2e50f">
			<File Source="dobbyVPN-windows\bin\DobbyVPN.exe" KeyPath="yes">
				<Shortcut 
					Id="DobbyVPNStartMenuShortcut" 
					Directory="ProgramMenuFolder" 
					Name="DobbyVPN" 
					Description="DobbyVPN: Secure VPN" 
					WorkingDirectory="DobbyVPNFolderBin" 
					Advertise="yes" />
				<Shortcut 
					Id="ApplicationDesktopShortcut"
					Directory="DesktopFolder" 
					Name="DobbyVPN"
					Description="DobbyVPN: Secure VPN"
					WorkingDirectory="DobbyVPNFolderBin" />
			</File>
		</Component>
        <Component Directory="DobbyVPNFolderBin" Id="DobbyVPNProtocol" Guid="64714854-31e1-4ca5-ac1c-fbf384c58421">
            <RegistryKey Root="HKLM" Key="Software\Classes\dobbyvpn" ForceDeleteOnUninstall="yes">
                <RegistryValue Type="string" Value="URL:DobbyVPN" />
                <RegistryValue Name="URL Protocol" Type="string" Value="" KeyPath="yes" />
                <RegistryKey Key="shell\open\command">
                    <RegistryValue Type="string" Value="&quot;[DobbyVPNFolderBin]DobbyVPN.exe&quot; &quot;%1&quot;" />
                </RegistryKey>
            </RegistryKey>
        </Component>
		<Component Directory="DobbyVPNFolderBin" Id="DobbyVPNCliExecutable" Guid="31c65f0f-407e-4d7b-99cb-3b5de6d2ea2e">
			<File Source="dobbyVPN-windows\bin\dobby-cli.exe" KeyPath="yes" />
		</Component>
		<!-- The v1.5.1 service key file and runtime closure changed. -->
		<Component Directory="DobbyVPNFolderBin" Id="DobbyVPNServerService" Guid="5810499f-aa36-44a7-b9df-9a9505597be2">
			<File Id="DobbyBackendFile" Source="dobbyVPN-windows\bin\dobbyvpn-backend.exe" KeyPath="yes" />
			<File Source="dobbyVPN-windows\bin\dobby_bridge.dll" />
			<File Source="wintun\bin\$(var.DOBBYVPN_PLATFORM)\wintun.dll" />

			<ServiceInstall 
					Id="svc.Install"
					Name="DobbyVPN Go backend"
					DisplayName="DobbyVPN Go backend"
					Description="Shared Go backend for DobbyVPN connections."
					Type="ownProcess"
					Start="auto"
					ErrorControl="normal"
					Arguments="-mode=service" >
				<ServiceDependency Id="Nsi" />
				<ServiceDependency Id="TcpIp" />
				<!-- Match the Go cleanup budget without reconfiguring SCM during automatic startup. -->
				<ServiceConfig PreShutdownDelay="30000" OnInstall="yes" OnReinstall="yes" />
				<util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart"
					ThirdFailureActionType="restart" RestartServiceDelayInSeconds="1" ResetPeriodInDays="1" />
			</ServiceInstall>
			<ServiceControl
					Id="svc.Control"
					Name="DobbyVPN Go backend"
					Start="install"
					Stop="both"
					Remove="uninstall"
					Wait="yes" />
			<!-- Default to the installer SID; test installs may supply the interactive account SID. -->
			<RegistryValue
					Root="HKLM"
				Key="SYSTEM\CurrentControlSet\Services\DobbyVPN Go backend"
					Name="Environment"
					Type="multiString">
				<MultiStringValue Value="DOBBYVPN_CONTROL_PIPE_SID=[DOBBYVPN_CONTROL_PIPE_SID]" />
			</RegistryValue>
		</Component>
		
		<!-- Event Log source for startup failures that happen before the service handler runs.
		     EventCreate.exe supplies the message text for event IDs 1-1000. -->
		<Component Directory="DobbyVPNFolderBin" Id="DobbyVPNEventSource" Guid="390613db-cd4a-4303-8b6a-d0cb483b7396">
			<RegistryKey Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\DobbyVPN Go backend" ForceDeleteOnUninstall="yes">
				<RegistryValue Name="EventMessageFile" Type="expandable" Value="%SystemRoot%\System32\EventCreate.exe" KeyPath="yes" />
				<RegistryValue Name="TypesSupported" Type="integer" Value="7" />
			</RegistryKey>
		</Component>

		<!-- The unpackaged WinUI app loads its self-contained runtime files beside the EXE. -->
		<Files Directory="DobbyVPNFolderBin" Include="dobbyVPN-windows\bin\**">
			<Exclude Files="dobbyVPN-windows\bin\DobbyVPN.exe" />
			<Exclude Files="dobbyVPN-windows\bin\dobby-cli.exe" />
			<Exclude Files="dobbyVPN-windows\bin\dobbyvpn-backend.exe" />
			<Exclude Files="dobbyVPN-windows\bin\dobby_bridge.dll" />
			<Exclude Files="dobbyVPN-windows\bin\wintun.dll" />
		</Files>
		<Files Directory="DobbyVPNFolderApp" Include="dobbyVPN-windows\app\**" />
    </ComponentGroup>
  </Fragment>
</Wix>
