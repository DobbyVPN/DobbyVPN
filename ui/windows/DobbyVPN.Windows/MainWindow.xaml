<Window
    x:Class="DobbyVPN.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DobbyVPN">
  <Grid x:Name="Root" MinWidth="560" Margin="24" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="DobbyVPN" Style="{StaticResource TitleTextBlockStyle}" />
      <Button Grid.Column="1" Content="About" Click="About_Click" />
    </Grid>
    <StackPanel Grid.Row="1" Spacing="6">
      <TextBox x:Name="SourceEditor" Header="Subscription URL" PlaceholderText="https://…" AutomationProperties.AutomationId="Connection configuration" AutomationProperties.Name="Subscription URL" />
      <HyperlinkButton x:Name="SourceModeButton" Content="Use configuration text…" Click="SourceMode_Click" />
    </StackPanel>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel Spacing="4">
        <TextBlock x:Name="StatusText" Text="Disconnected" AutomationProperties.AutomationId="Disconnected" AutomationProperties.LiveSetting="Polite" />
        <TextBlock x:Name="ProfileText" TextWrapping="WrapWholeWords" />
        <TextBlock x:Name="FailureText" TextWrapping="WrapWholeWords" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        <TextBlock x:Name="ErrorText" TextWrapping="WrapWholeWords" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <ProgressRing x:Name="ConnectionProgress" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
        <Button x:Name="ConnectionButton" Content="Connect" Click="ConnectionButton_Click" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="VPN connection action">
          <Button.KeyboardAccelerators><KeyboardAccelerator Key="Enter" Modifiers="Control" /></Button.KeyboardAccelerators>
        </Button>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="3" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Logs" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Jump to latest" Click="JumpToLatest_Click" />
          <Button Content="Copy" Click="CopyLogs_Click" />
          <Button Content="Save logs…" Click="SaveLogs_Click" />
        </StackPanel>
      </Grid>
      <TextBlock x:Name="LogsErrorText" Grid.Row="1" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="WrapWholeWords" />
      <TextBlock Grid.Row="2" Text="Recent logs. Saved diagnostics include the complete files." Style="{StaticResource CaptionTextBlockStyle}" />
      <TextBox x:Name="LogsText" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="Backend logs" Loaded="LogsText_Loaded" />
    </Grid>
  </Grid>
</Window>
