<Window
    x:Class="DobbyVPN.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DobbyVPN">
  <Grid x:Name="Root" MinWidth="560" Margin="24" RowDefinitions="Auto,Auto,*" RowSpacing="16">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="DobbyVPN" Style="{StaticResource TitleTextBlockStyle}" />
      <Button Grid.Column="1" Content="About" Click="About_Click" AutomationProperties.AutomationId="About" />
    </Grid>
    <ScrollViewer x:Name="ControlsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="Connection controls">
      <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox x:Name="SourceEditor" Header="Subscription URL" PlaceholderText="https://…" AutomationProperties.AutomationId="Connection configuration" AutomationProperties.Name="Subscription URL" />
          <Button x:Name="PasteButton" Grid.Column="1" VerticalAlignment="Bottom" Content="Paste" Click="Paste_Click" Visibility="Collapsed" AutomationProperties.AutomationId="Paste" />
          </Grid>
          <TextBlock x:Name="LoadStatus" TextWrapping="Wrap" />
          <Button x:Name="RetryButton" Content="Retry" Click="Retry_Click" Visibility="Collapsed" AutomationProperties.AutomationId="Retry" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="4">
            <TextBlock x:Name="StatusText" Text="Disconnected" AutomationProperties.AutomationId="Disconnected" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="ProfileText" TextWrapping="WrapWholeWords" />
            <Button x:Name="ActiveStopButton" Content="Disconnect" Click="ActiveStop_Click" Visibility="Collapsed" AutomationProperties.AutomationId="Active connection action" />
            <TextBlock x:Name="FailureText" TextWrapping="WrapWholeWords" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            <TextBlock x:Name="ErrorText" TextWrapping="WrapWholeWords" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ProgressRing x:Name="ConnectionProgress" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
            <Button x:Name="ConnectionButton" Content="Connect" Click="ConnectionButton_Click" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="VPN connection action">
              <Button.KeyboardAccelerators><KeyboardAccelerator Key="Enter" Modifiers="Control" /></Button.KeyboardAccelerators>
            </Button>
          </StackPanel>
        </Grid>
        <ScrollViewer x:Name="ProfilesScroll" Grid.Row="2" MaxHeight="180" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="Profile list viewport">
          <StackPanel x:Name="ProfileList" Spacing="8" />
        </ScrollViewer>
      </Grid>
    </ScrollViewer>
    <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Logs" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Clear" Click="ClearLogs_Click" AutomationProperties.AutomationId="Clear" />
          <Button Content="Save logs…" Click="SaveLogs_Click" AutomationProperties.AutomationId="Save logs" />
        </StackPanel>
      </Grid>
      <TextBlock x:Name="LogsErrorText" Grid.Row="1" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="WrapWholeWords" />
      <TextBlock Grid.Row="2" Text="Recent logs. Saved diagnostics include both retained generations." Style="{StaticResource CaptionTextBlockStyle}" />
      <ScrollViewer x:Name="LogsScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" Loaded="LogsText_Loaded" AutomationProperties.AutomationId="Backend logs">
        <StackPanel x:Name="LogEntries" Spacing="8" />
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
