<Window
    x:Class="DobbyVPN.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DobbyVPN.Windows"
    Title="doBBYVPN">
  <Grid x:Name="Root" RequestedTheme="Light" Background="#D9D2C9" Tapped="Root_Tapped">
    <Grid.Resources>
      <SolidColorBrush x:Key="Paper" Color="#D9D2C9" />
      <SolidColorBrush x:Key="Ink" Color="#141414" />
      <SolidColorBrush x:Key="Surface" Color="#F6F3EE" />
      <SolidColorBrush x:Key="Muted" Color="#55504A" />
      <SolidColorBrush x:Key="Rule" Color="#B9B1A6" />
      <SolidColorBrush x:Key="Tray" Color="#CCC4B9" />
      <SolidColorBrush x:Key="Scrim" Color="#52000000" />
      <SolidColorBrush x:Key="Clear" Color="Transparent" />
      <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
      <Style x:Key="PlainButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <ContentPresenter x:Name="ContentPresenter"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  Content="{TemplateBinding Content}"
                  ContentTemplate="{TemplateBinding ContentTemplate}"
                  Foreground="{TemplateBinding Foreground}"
                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                  AutomationProperties.AccessibilityView="Raw">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                      <VisualState.Setters><Setter Target="ContentPresenter.Opacity" Value="0.85" /></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                      <VisualState.Setters><Setter Target="ContentPresenter.Opacity" Value="0.7" /></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled" />
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
              </ContentPresenter>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="FilledButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
        <Setter Property="Background" Value="{StaticResource Ink}" />
        <Setter Property="Foreground" Value="{StaticResource Surface}" />
        <Setter Property="FontSize" Value="12.75" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="6" />
      </Style>
      <Style x:Key="OutlinedButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
        <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontSize" Value="12.75" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="6" />
      </Style>
    </Grid.Resources>

    <ContentControl x:Name="FocusSink" Width="1" Height="1" Opacity="0" IsTabStop="False" UseSystemFocusVisuals="False"
                    HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" />

    <Grid x:Name="Column" MaxWidth="480" RowDefinitions="Auto,Auto,*">
      <UserControl IsTabStop="False" AutomationProperties.AutomationId="Connection controls" AutomationProperties.Name="Connection controls">
      <StackPanel x:Name="Controls" Padding="9,6,9,9" Spacing="6">
        <Border x:Name="SourceField" MinHeight="33" Padding="9,0,9,0" CornerRadius="6" BorderThickness="1.5"
                BorderBrush="{StaticResource Ink}" Background="{StaticResource Surface}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBox x:Name="SourceEditor" PlaceholderText="Subscription URL" FontSize="12.75" InputScope="Url"
                     IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                     VerticalAlignment="Center" MinHeight="0" Padding="0,4,0,4" BorderThickness="0"
                     Foreground="{StaticResource Ink}"
                     AutomationProperties.AutomationId="Connection configuration" AutomationProperties.Name="Subscription URL">
              <TextBox.Resources>
                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlForeground" Color="#141414" />
                <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#141414" />
                <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#141414" />
                <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#55504A" />
                <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#55504A" />
                <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#55504A" />
                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
              </TextBox.Resources>
            </TextBox>
            <TextBlock x:Name="LoadingText" Grid.Column="1" Text="Loading…" FontSize="11.05" VerticalAlignment="Center"
                       Foreground="{StaticResource Muted}" Visibility="Collapsed" />
            <Button x:Name="PasteButton" Grid.Column="1" Content="Paste" Style="{StaticResource FilledButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" MinHeight="25.5" Padding="10.5,0"
                    CornerRadius="4.5" FontSize="11.9" Click="Paste_Click" Visibility="Collapsed"
                    AutomationProperties.AutomationId="Paste" />
          </Grid>
        </Border>

        <Button x:Name="ConnectionButton" Content="Auto connect" Style="{StaticResource PlainButton}" MinHeight="45"
                CornerRadius="7.5" FontSize="17" FontWeight="SemiBold" Click="ConnectionButton_Click" IsEnabled="False" KeyboardAcceleratorPlacementMode="Hidden"
                AutomationProperties.AutomationId="VPN connection action">
          <Button.KeyboardAccelerators><KeyboardAccelerator Key="Enter" Modifiers="Control" /></Button.KeyboardAccelerators>
        </Button>

        <StackPanel x:Name="ActiveFailurePanel" Spacing="6" Visibility="Collapsed"
                    AutomationProperties.AutomationId="connection.active-failure">
          <TextBlock x:Name="ActiveFailureText" FontSize="11.9" TextWrapping="Wrap"
                     Foreground="{StaticResource Ink}" AutomationProperties.AutomationId="connection.failure" />
          <Button x:Name="StopActiveButton" Content="Stop" Style="{StaticResource OutlinedButton}" MinHeight="33"
                  Click="StopActive_Click" Visibility="Collapsed"
                  AutomationProperties.AutomationId="connection.stop" />
        </StackPanel>

        <Border x:Name="ConnectionsTray" Margin="0,6,0,0" CornerRadius="10.5" Background="{StaticResource Tray}">
          <Grid>
            <local:SockIcon x:Name="EmptySock" Width="30" Height="37.5"
                            AutomationProperties.Name="No subscription yet" AutomationProperties.AccessibilityView="Content" />
            <StackPanel x:Name="LoadFailed" Spacing="7.5" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
              <local:HoleySockIcon Width="30" Height="37.5" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
              <TextBlock Text="Couldn't load the subscription" FontSize="12.75" FontWeight="Medium"
                         Foreground="{StaticResource Ink}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
              <Button Content="Retry" Style="{StaticResource FilledButton}" HorizontalAlignment="Center" MinHeight="30"
                      Padding="16.5,0" Click="Retry_Click" AutomationProperties.AutomationId="tray.retry" />
            </StackPanel>
            <ScrollViewer x:Name="ProfilesScroll" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed"
                          AutomationProperties.AutomationId="Profile list viewport">
              <StackPanel x:Name="ProfileList" Padding="6" Spacing="6" />
            </ScrollViewer>
          </Grid>
        </Border>
      </StackPanel>
      </UserControl>

      <Rectangle Grid.Row="1" Height="1.5" Fill="{StaticResource Ink}" />

      <ScrollViewer x:Name="LogsScroll" Grid.Row="2" Background="{StaticResource Surface}" Padding="9,4.5,9,4.5"
                    VerticalScrollBarVisibility="Auto" Loaded="LogsText_Loaded"
                    AutomationProperties.AutomationId="Connection logs">
        <ScrollViewer.ContextFlyout>
          <MenuFlyout x:Name="LogsMenu">
            <MenuFlyout.MenuFlyoutPresenterStyle>
              <Style TargetType="MenuFlyoutPresenter">
                <Setter Property="Background" Value="#F6F3EE" />
              </Style>
            </MenuFlyout.MenuFlyoutPresenterStyle>
            <MenuFlyoutItem x:Name="SendLogsItem" Text="Send logs" HorizontalContentAlignment="Center" Click="SendLogs_Click" AutomationProperties.AutomationId="logs.export" />
            <MenuFlyoutItem Text="Clear" HorizontalContentAlignment="Center" Click="ClearLogs_Click" AutomationProperties.AutomationId="logs.clear" />
          </MenuFlyout>
        </ScrollViewer.ContextFlyout>
        <StackPanel x:Name="LogEntries" />
      </ScrollViewer>
    </Grid>

    <Grid x:Name="ErrorOverlay" Background="{StaticResource Scrim}" Visibility="Collapsed" Tapped="ErrorOverlay_Tapped">
      <UserControl x:Name="ErrorCard" MaxWidth="420" Margin="18" VerticalAlignment="Center" IsTabStop="False"
                   TabFocusNavigation="Cycle" Tapped="ErrorCard_Tapped" AutomationProperties.AutomationId="error.dialog" AutomationProperties.IsDialog="True">
      <Border Padding="12,12,12,9" CornerRadius="7.5" BorderThickness="1.5" BorderBrush="{StaticResource Ink}" Background="{StaticResource Surface}">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7.5">
            <local:HoleySockIcon Width="19.5" Height="24.4" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="ErrorTitle" Grid.Column="1" FontSize="15.3" FontWeight="SemiBold" TextWrapping="Wrap"
                       VerticalAlignment="Center" Foreground="{StaticResource Ink}" />
          </Grid>
          <TextBlock x:Name="ErrorHint" Grid.Row="1" Margin="0,6,0,0" FontSize="11.9" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                     Text="Check the link and whether another VPN is blocking it." />
          <Border Grid.Row="2" MaxHeight="240" Margin="0,7.5,0,0" Padding="7.5,6" CornerRadius="4.5" BorderThickness="1" BorderBrush="{StaticResource Rule}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                            AutomationProperties.AutomationId="error.detail.viewport">
              <TextBox x:Name="ErrorDetail" FontFamily="{StaticResource Mono}" FontSize="9.8" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" Foreground="{StaticResource Ink}"
                       Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       AutomationProperties.Name="Error details" AutomationProperties.AutomationId="error.detail" />
              </ScrollViewer>
              <Button Grid.Column="1" Style="{StaticResource PlainButton}" VerticalAlignment="Center" Click="CopyError_Click"
                      AutomationProperties.Name="Copy">
                <TextBlock Text="Copy" FontSize="10.2" FontWeight="SemiBold" TextDecorations="Underline" Foreground="{StaticResource Ink}" />
              </Button>
            </Grid>
          </Border>
          <Grid Grid.Row="3" Margin="0,10.5,0,0" ColumnDefinitions="*,*" ColumnSpacing="6">
            <Button x:Name="CloseErrorButton" Content="Close" Style="{StaticResource OutlinedButton}" MinHeight="33"
                    Click="CloseError_Click" KeyboardAcceleratorPlacementMode="Hidden">
              <Button.KeyboardAccelerators><KeyboardAccelerator Key="Escape" /></Button.KeyboardAccelerators>
            </Button>
            <Button x:Name="RetryErrorButton" Grid.Column="1" Content="Retry" Style="{StaticResource FilledButton}" MinHeight="33"
                    Click="RetryError_Click" AutomationProperties.AutomationId="subscription.retry" />
          </Grid>
        </Grid>
      </Border>
      </UserControl>
    </Grid>
  </Grid>
</Window>
