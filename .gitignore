# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

#configs
*ckclient.json

# iOS / Xcode build artifacts
**/DerivedData/
**/xcuserdata/
**/*.xcuserstate
**/*.xccheckout
**/*.xcscmblueprint

# Xcode project workspace artifacts (auto-generated inside *.xcodeproj)
**/*.xcodeproj/project.xcworkspace/
**/*.xcodeproj/project.xcworkspace/**/*

# iOS outputs
**/*.ipa
**/*.dSYM
**/*.dSYM.zip
**/*.xcarchive

# KMP/Xcode integration output (frameworks produced for Xcode)
**/app/build/xcode-frameworks/
/swift_module/app.framework/

# Generated XCFrameworks (project-local)
**/*.xcframework

# Lint reports (generated by `task report` / `make report`)
/reports/

# Local toolchains and logs produced by scripts/*_cli_check.*
/.local-tools/
/grpcvpnserver.log
/grpcvpnserver.out
/grpcvpnserver.err

# Python virtual environments (from scripts like updateairports.sh)
**/.venv/
**/venv/
**/__pycache__/
*.pyc

# Copied from canonical KMP proto during go_module/scripts/regenerate-grpcproto.sh
go_module/grpcproto/vpnserver.proto

# Local release qualification stages the exact downloaded Debian package here.
# It is an ignored build artifact, never application source.
/kmp_module/app/dobbyVPN-linux.deb

# Public desktop_build.py and Conveyor generate these local staging trees.
# They are reproducible build outputs, never application source.
/kmp_module/services/
/output/

# Owner-local Harness/runtime worktrees and qualification artefacts.
# These are private generated state, never application source.
/runtime/
